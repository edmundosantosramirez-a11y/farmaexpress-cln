# Copia este archivo a .env y ajusta los valores. NO subas .env al repositorio.
APP_ENV=development

# Docker Compose usa estas tres variables para crear la base y armar DATABASE_URL.
POSTGRES_USER=farma
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=farmaexpress

# Solo si corres la API fuera de Docker (uvicorn en tu máquina). Sin esta variable la API usa memoria.
# DATABASE_URL=postgresql://farma:cambia_esta_clave@localhost:5432/farmaexpress

# Cargar lotes y productos de demostración al iniciar si la base está vacía.
SEED_DEMO_DATA=true
